<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_card"
    android:clipToOutline="true">

    <!-- Custom Wallpaper / Photo Background -->
    <ImageView
        android:id="@+id/widget_photo_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="Widget Background Photo" />

    <!-- Dark Acrylic Dimming Overlay for Text Contrast -->
    <View
        android:id="@+id/widget_dark_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000" />

    <!-- Main Widget Foreground Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Top Header: Day & Gregorian Date + Weather / Season Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_day_english"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="THURSDAY, 20 FEB"
                    android:textColor="#FF60A5FA"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_date_full_en"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="20 February 2025"
                    android:textColor="#CCFFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_badge_season"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_chip_rounded"
                android:paddingLeft="8dp"
                android:paddingTop="3dp"
                android:paddingRight="8dp"
                android:paddingBottom="3dp"
                android:text="🌿 বসন্তকাল"
                android:textColor="#FFFFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Middle Card: Bengali & Hijri Date Highlights -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/widget_chip_rounded"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp">

            <TextView
                android:id="@+id/widget_bangla_digit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="৭"
                android:textColor="#FFFBBF24"
                android:textSize="22sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_bangla_full"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="৭ ফাল্গুন ১৪৩১ বঙ্গাব্দ"
                    android:textColor="#FFFFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_hijri_full"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌙 ২১ শা'বান ১৪৪৬ হিজরি"
                    android:textColor="#D9E2E8F0"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Events & Tasks Preview Strip -->
        <TextView
            android:id="@+id/widget_event_task_strip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="📅 আজকের কর্মসূচি: কোনো বিশেষ ইভেন্ট নেই"
            android:textColor="#E6CBD5E1"
            android:textSize="10sp" />

        <!-- Spacer to push Action Bar to bottom -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Bottom Action Bar (Direct one-tap buttons) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Open App Button -->
            <LinearLayout
                android:id="@+id/widget_btn_open_app"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:background="@drawable/widget_action_btn_bg"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="4dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_widget_calendar"
                    android:contentDescription="Open App" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="ক্যালেন্ডার"
                    android:textColor="#FFFFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Add Event Button -->
            <LinearLayout
                android:id="@+id/widget_btn_add_event"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/widget_action_btn_bg"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="4dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_widget_add"
                    android:contentDescription="Add Event" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="ইভেন্ট +"
                    android:textColor="#FFFFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Quick Refresh Widget Button -->
            <ImageView
                android:id="@+id/widget_btn_refresh"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/widget_action_btn_bg"
                android:padding="8dp"
                android:src="@drawable/ic_widget_refresh"
                android:contentDescription="Refresh Widget" />

            <!-- Customize Widget Photo & Style Button -->
            <ImageView
                android:id="@+id/widget_btn_customize"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/widget_action_btn_bg"
                android:padding="8dp"
                android:src="@drawable/ic_widget_palette"
                android:contentDescription="Customize Style" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
